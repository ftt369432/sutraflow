{
  "compilerOptions": {
    "target": "es6",
    "useDefineForClassFields": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "esnext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": false,
    "noImplicitAny": false,
    "noImplicitReturns": false,
    "noImplicitThis": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "**/*.spec.ts",
    "**/*.backup.*",
    "src/tests/**/*",
    "test-*.ts",
    "scripts/**/*",
    "src/utils/testHearingReschedule.ts",
    "src/utils/testTeamOperations.ts",
    "src/pages/AIAssistant.working-backup.tsx",
    "src/services/agents/AIAgentSystemTest.ts",
    "src/services/demo/**/*",
    "src/components/canvas/legacy/**/*",
    "src/pages/legacy/**/*",
    "src/legacy/**/*"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}